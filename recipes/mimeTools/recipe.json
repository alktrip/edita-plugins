{
	"folder-name": "mimeTools",
	"display-name": "MIME Tools",
	"version": "3.2",
	"npp-compatible-versions": "[0.0.1,]",
	"description": "Base64, Quoted-printable, URL encode/decode and SAML decode. It is the original source code of the Notepad++ plugin (npp-plugins/mimetools, v3.2), unchanged, with Edita's compatibility layer.",
	"description-es": "Base64, Quoted-printable, URL encode/decode y SAML decode. Es el código original del plugin de Notepad++ (npp-plugins/mimetools, v3.2), sin cambios, con la capa de compatibilidad de Edita.",
	"author": "Don HO, Paul Nankervis (Edita port: Edita contributors)",
	"homepage": "https://github.com/npp-plugins/mimetools",
	"license": "GPL-3.0-or-later",
	"license-files": [
		"license.txt"
	],
	"source": {
		"url": "https://github.com/npp-plugins/mimetools/archive/refs/tags/v3.2.zip",
		"sha256": "56b48316d413a3444916acf8d6f78c5b95ad8a704994e80c4bc231a3a3cf2735",
		"strip-components": 1
	},
	"remove": [
		"src/Scintilla.h",
		"src/Sci_Position.h"
	],
	"overlay": "overlay",
	"build-dir": "edita",
	"requires": [
		"cmake",
		"c++"
	],
	"check": {
		"commands": [
			"Base64 Encode",
			"Base64 Decode",
			"URL Encode (RFC1738)",
			"URL Decode",
			"Quoted-printable Encode",
			"Base64 Encode with padding",
			"URL Encode (Extended)"
		],
		"cases": [
			{
				"command": "Base64 Encode",
				"text": "Hola, Edita",
				"expect": "SG9sYSwgRWRpdGE"
			},
			{
				"command": "Base64 Decode",
				"text": "SG9sYSwgRWRpdGE=",
				"expect": "Hola, Edita"
			},
			{
				"command": "URL Decode",
				"text": "a%20b%C3%B1",
				"expect": "a bñ"
			},
			{
				"command": "URL Encode (RFC1738)",
				"text": "a b/c",
				"expect": "a%20b%2Fc"
			},
			{
				"command": "Base64 Encode with padding",
				"text": "Hola, Edita ñ",
				"expect": "SG9sYSwgRWRpdGEgw7E="
			},
			{
				"command": "URL Encode (Extended)",
				"text": "a b&c",
				"expect": "a%20b%26c"
			}
		]
	}
}
