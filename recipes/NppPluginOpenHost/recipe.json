{
	"folder-name": "NppPluginOpenHost",
	"display-name": "NppPluginOpenHost",
	"version": "1.1.0.0",
	"npp-compatible-versions": "[0.0.1,]",
	"description": "Abre el archivo hosts del sistema. El plugin de Notepad++ (jejemorg/NppPluginOpenHost, v1.1) abre el de Windows; el port de Edita, con un parche de una línea, abre /etc/hosts.",
	"author": "jejemorg (port a Edita: Edita contributors)",
	"homepage": "https://github.com/jejemorg/NppPluginOpenHost",
	"license": "Apache-2.0",
	"license-files": [
		"LICENSE"
	],
	"source": {
		"url": "https://github.com/jejemorg/NppPluginOpenHost/archive/refs/tags/1.1.zip",
		"sha256": "9d41df4d50e98d82354dfab2709dac6c74a0fd0c037e7cdbfc0c72279c278baa",
		"strip-components": 1
	},
	"remove": [
		"src/Scintilla.h"
	],
	"patches": [
		"hosts-unix.patch"
	],
	"overlay": "overlay",
	"build-dir": "edita",
	"requires": [
		"cmake",
		"c++",
		"patch"
	],
	"check": {
		"commands": [
			"Open"
		],
		"cases": [
			{
				"command": "Open",
				"expect-file": "/etc/hosts"
			}
		]
	}
}
