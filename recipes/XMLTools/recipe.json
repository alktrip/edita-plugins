{
	"folder-name": "XMLTools",
	"display-name": "XML Tools",
	"version": "3.1.1.13",
	"npp-compatible-versions": "[0.0.1,]",
	"description": "Comprobar la sintaxis y validar XML (DTD y XSD), formatear (pretty print), linealizar, ruta XPath actual, evaluar XPath, transformación XSL, escapar y comentar. Port de XML Tools (morbac/xmltools 3.1.1.13): usa su biblioteca QuickXml tal cual y libxml2/libxslt donde el original usa MSXML de Windows. Necesita libxml2 y libxslt (los traen casi todas las distribuciones).",
	"author": "Nicolas Crittin y colaboradores (port a Edita: Edita contributors)",
	"homepage": "https://github.com/morbac/xmltools",
	"license": "GPL-3.0-or-later",
	"license-files": [
		"LICENSE"
	],
	"source": {
		"url": "https://github.com/morbac/xmltools/archive/refs/tags/3.1.1.13.zip",
		"sha256": "37aeb36b0747ea824fd3d7cea85e96c46ed581992a6c1b8db74db5a58ced7813",
		"strip-components": 1
	},
	"patches": [
		"gcc-tolower.patch"
	],
	"overlay": "overlay",
	"build-dir": "edita",
	"requires": [
		"cmake",
		"c++",
		"pkg-config",
		"pkg-config:libxml-2.0"
	],
	"check": {
		"commands": [
			"Pretty print",
			"Linearize",
			"Check XML syntax now",
			"Current XML Path",
			"Comment selection",
			"Tag auto-close",
			"Prevent XXE",
			"Evaluate XPath expression...",
			"XSL Transformation...",
			"Escape characters in selection (<> → &&lt;&&gt;)"
		],
		"cases": [
			{
				"command": "Pretty print",
				"select": "none",
				"text": "<a><b>1</b><c x=\"2\"/></a>",
				"expect": "<a>\n\t<b>1</b>\n\t<c x=\"2\"/>\n</a>"
			},
			{
				"command": "Linearize",
				"select": "none",
				"text": "<a>\n  <b>1</b>\n</a>",
				"expect": "<a><b>1</b></a>"
			},
			{
				"command": "Comment selection",
				"text": "<b>1</b>",
				"expect": "<!--<b>1</b>-->"
			},
			{
				"command": "Escape characters in selection (<> → &&lt;&&gt;)",
				"text": "<x>&</x>",
				"expect": "&lt;x&gt;&amp;&lt;/x&gt;"
			}
		]
	}
}
